FROM maven:3.9.6-eclipse-temurin-21 AS build
WORKDIR /app

# 1. On copie tout ce que Render télécharge depuis GitHub
COPY . /app

# 2. LE PIÈGE : On demande à Linux de chercher le fichier pom.xml. 
# Si la commande ne trouve rien, elle va écrire "FICHIER INTROUVABLE".
# Si elle trouve quelque chose, elle va afficher le chemin exact (ex: /app/pom.xml) directement dans l'erreur rouge.
RUN find /app -name pom.xml | grep "pom.xml"
