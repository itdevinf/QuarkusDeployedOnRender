# ---- Étape 1 : Compilation ----
FROM maven:3.9.6-eclipse-temurin-17 AS build
# On travaille à la racine absolue du conteneur
WORKDIR /
# On copie TOUS les fichiers de GitHub (y compris le pom.xml qui est à la racine)
COPY . .
# On lance la compilation là où est le pom.xml
RUN mvn clean package -DskipTests

# ---- Étape 2 : Exécution ----
FROM eclipse-temurin:17-jre
WORKDIR /deployments/
# On récupère les dossiers générés par l'étape 1
COPY --from=build /target/quarkus-app/lib/ /deployments/lib/
COPY --from=build /target/quarkus-app/*.jar /deployments/
COPY --from=build /target/quarkus-app/app/ /deployments/app/
COPY --from=build /target/quarkus-app/quarkus/ /deployments/quarkus/

EXPOSE 8080
ENV JAVA_APP_JAR="/deployments/quarkus-run.jar"
CMD ["java", "-jar", "/deployments/quarkus-run.jar"]
